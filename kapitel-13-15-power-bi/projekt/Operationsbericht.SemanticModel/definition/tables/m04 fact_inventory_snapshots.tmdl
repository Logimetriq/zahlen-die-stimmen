table 'm04 fact_inventory_snapshots'
	lineageTag: 69702784-cd6b-4c12-83ab-f06192e09515

	measure Bestandsbeobachtungen = IF(HASONEVALUE('m04 dim_date'[calendar_date]), COALESCE(COUNTROWS('m04 fact_inventory_snapshots'), 0), BLANK())
		formatString: 0
		displayFolder: CH14\Berechnungen
		lineageTag: 10c6267d-36bd-55f1-b9a8-7fa3def805b9

	measure 'Bewertete Bestandsbeobachtungen' = IF(HASONEVALUE('m04 dim_date'[calendar_date]), COALESCE(COUNT('m04 fact_inventory_snapshots'[inventory_value_eur]), 0), BLANK())
		formatString: 0
		displayFolder: CH14\Berechnungen
		lineageTag: 8b085062-72c7-5877-85d0-f503a07eb4eb

	measure Bewertungsabdeckung = DIVIDE([Bewertete Bestandsbeobachtungen], [Bestandsbeobachtungen])
		formatString: 0.00%
		displayFolder: CH14\Berechnungen
		lineageTag: e6a9a4ed-86ef-5762-bb40-e2173a6e4887

	measure 'Bekannter Bestandswert' = IF(HASONEVALUE('m04 dim_date'[calendar_date]) && SELECTEDVALUE('m04 fact_inventory_snapshots'[currency]) = "EUR", SUM('m04 fact_inventory_snapshots'[inventory_value_eur]), BLANK())
		formatString: #,0.00 "EUR"
		displayFolder: CH14\Berechnungen
		lineageTag: 075eb188-ea4f-5d99-bc2e-073b2ad4061e

	measure 'Vollständiger Bestandswert' = IF([Bestandsbeobachtungen] > 0 && [Bewertete Bestandsbeobachtungen] = [Bestandsbeobachtungen], [Bekannter Bestandswert], BLANK())
		formatString: #,0.00 "EUR"
		displayFolder: CH14\Berechnungen
		lineageTag: e6c5b27f-4a4f-593e-9f21-c3f383834fab

	measure Bewertungsumfang = IF(ISBLANK([Bestandsbeobachtungen]), "Stichtag nicht eindeutig", IF([Bestandsbeobachtungen] = 0, "Keine Bestandsbeobachtung; Abdeckung nicht definiert", FORMAT([Bewertete Bestandsbeobachtungen], "0") & " von " & FORMAT([Bestandsbeobachtungen], "0") & " beobachteten Zeilen bewertet; " & IF([Bewertete Bestandsbeobachtungen] = [Bestandsbeobachtungen], "COMPLETE für beobachtete Auswahl", "LIMITED für beobachtete Auswahl")))
		displayFolder: Reportdarstellung
		lineageTag: e4abf24b-44dd-518c-ac74-212131917127

	measure 'Bekannter Wert Anzeige' = IF(ISBLANK([Bekannter Bestandswert]), "Bekannter Wert: unbekannt", "Bekannter Wert: " & FORMAT([Bekannter Bestandswert], "#,0.00") & " EUR")
		displayFolder: Reportdarstellung
		lineageTag: 7b57127e-c825-5b1c-867b-505441cde1f5

	measure 'Vollwert Anzeige' = IF(ISBLANK([Vollständiger Bestandswert]), "Vollständiger Wert: unbekannt", "Vollständiger Wert: " & FORMAT([Vollständiger Bestandswert], "#,0.00") & " EUR")
		displayFolder: Reportdarstellung
		lineageTag: 8d2d9c16-b59d-538c-b24d-f130f317a36b

	measure 'Beobachtete Stück' = IF([Bestandsbeobachtungen] > 0, SUM('m04 fact_inventory_snapshots'[quantity]), BLANK())
		displayFolder: Reportdarstellung
		lineageTag: c94abf9e-32c5-5213-b46c-0cbba8cfd90a

	measure 'Bewertung Detail' = IF([Bestandsbeobachtungen] > 0, IF([Bewertete Bestandsbeobachtungen] = [Bestandsbeobachtungen], "Bewertet: " & FORMAT([Bekannter Bestandswert], "#,0.00") & " EUR", "Preis fehlt; Wert unbekannt"), BLANK())
		displayFolder: Reportdarstellung
		lineageTag: 3eac86f5-2569-53fd-a1a6-1b12ee3527eb

