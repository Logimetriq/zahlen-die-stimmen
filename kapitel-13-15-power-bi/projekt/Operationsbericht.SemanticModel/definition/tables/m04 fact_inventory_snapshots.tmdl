	partition 'm04 fact_inventory_snapshots' = m
		mode: import
		source =
				let
				    Quelle = PostgreSQL.Database(Server, Database),
				    Tabelle = Quelle{[Schema = "m04", Item = "fact_inventory_snapshots"]}[Data],
				    Auswahl = Table.SelectColumns(Tabelle, {"warehouse_id", "product_id", "snapshot_date", "quantity", "price", "inventory_value_eur", "currency", "inventory_price_missing"}),
				    Typen = Table.TransformColumnTypes(Auswahl, {{"warehouse_id", type text}, {"product_id", type text}, {"snapshot_date", type date}, {"quantity", Int64.Type}, {"price", Currency.Type}, {"inventory_value_eur", Currency.Type}, {"currency", type text}, {"inventory_price_missing", type logical}})
				in
				    Typen

