table 'm04 fact_orders'
	lineageTag: 09c5c9a1-3a56-4be8-b2d7-0080a745e194

	measure Bestellanzahl = COALESCE(COUNTROWS('m04 fact_orders'), 0)
		formatString: 0
		displayFolder: CH14\Berechnungen
		lineageTag: 6771bf7c-30c8-5d1d-9e35-ca4d64c67cee

	measure Bestellbetrag = IF(COUNTROWS('m04 fact_orders') = 0, 0, IF(COUNT('m04 fact_orders'[order_amount_eur]) = COUNTROWS('m04 fact_orders') && SELECTEDVALUE('m04 fact_orders'[currency]) = "EUR", SUM('m04 fact_orders'[order_amount_eur]), BLANK()))
		formatString: #,0.00 "EUR"
		displayFolder: CH14\Berechnungen
		lineageTag: 03bd2a5d-5f47-5388-b997-9708847b6e86

	measure 'Bearbeitungsdauer gesamt' = SUM('m04 fact_orders'[duration_min])
		formatString: 0.00 "min"
		displayFolder: CH14\Berechnungen
		lineageTag: 7b5b24eb-5d06-5cb0-93b3-ade98ca30717

	measure 'Mittlere Bearbeitungsdauer' = DIVIDE([Bearbeitungsdauer gesamt], COUNT('m04 fact_orders'[duration_min]))
		formatString: 0.00 "min"
		displayFolder: CH14\Berechnungen
		lineageTag: da1a3691-4489-575c-8390-83c61d492232

	measure 'Bestellungen über 60 Minuten' = COALESCE(CALCULATE(COUNT('m04 fact_orders'[duration_min]), KEEPFILTERS('m04 fact_orders'[duration_min] > 60)), 0)
		formatString: 0
		displayFolder: CH14\Berechnungen
		lineageTag: 0ae7f2fa-2a69-5fdb-929c-ed3df2f80b23

	measure Verzögerungsquote = DIVIDE([Bestellungen über 60 Minuten], COUNT('m04 fact_orders'[duration_min]))
		formatString: 0.00%
		displayFolder: CH14\Berechnungen
		lineageTag: 43c64970-cc88-5905-8999-88ad2a3bad24

	measure 'Mittlere Dauer gewichtet' = DIVIDE(SUMX(VALUES('m04 dim_product'[product_id]), [Mittlere Bearbeitungsdauer] * CALCULATE(COUNT('m04 fact_orders'[duration_min]))), COUNT('m04 fact_orders'[duration_min]))
		formatString: 0.00 "min"
		displayFolder: CH14\Berechnungen
		lineageTag: e87c5b58-244c-526a-b810-5bec553e5121

	measure 'Bestellbetrag nach Abschluss' = CALCULATE([Bestellbetrag], USERELATIONSHIP('m04 fact_orders'[processed_date], 'm04 dim_date'[calendar_date]))
		formatString: #,0.00 "EUR"
		displayFolder: CH14\Berechnungen
		lineageTag: 863fbcc1-a2cb-5e2a-a488-886ea03e947b

	measure Reportstand = "Quelle: SQL-M04 1.1 / CH11-V1 | Kenntnis: 15.09.2026 06:00 UTC | Report/Modell: 3.0 | Geprüfter Import: 08.10.2026 17:11:41 UTC (kontrollierter Stand)"
		displayFolder: Reportdarstellung
		lineageTag: 36a86f0b-c2a5-4c05-ab4f-0d26fc7cf41f

