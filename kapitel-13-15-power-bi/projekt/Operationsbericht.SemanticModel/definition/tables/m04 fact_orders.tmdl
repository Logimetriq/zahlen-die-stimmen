	partition 'm04 fact_orders' = m
		mode: import
		source =
				let
				    Quelle = PostgreSQL.Database(Server, Database, [Query = "SELECT order_id, revision_id, customer_id, warehouse_id, product_id, order_amount_eur, currency, event_at AT TIME ZONE 'UTC' AS event_at, received_at AT TIME ZONE 'UTC' AS received_at, processed_at AT TIME ZONE 'UTC' AS processed_at, available_at AT TIME ZONE 'UTC' AS available_at, processing_group, received_date, processed_date, duration_min FROM m04.fact_orders"]),
				    Auswahl = Table.SelectColumns(Quelle, {"order_id", "revision_id", "customer_id", "warehouse_id", "product_id", "order_amount_eur", "currency", "event_at", "received_at", "processed_at", "available_at", "processing_group", "received_date", "processed_date", "duration_min"}),
				    Typen = Table.TransformColumnTypes(Auswahl, {{"order_id", type text}, {"revision_id", type text}, {"customer_id", type text}, {"warehouse_id", type text}, {"product_id", type text}, {"order_amount_eur", Currency.Type}, {"currency", type text}, {"event_at", type datetime}, {"received_at", type datetime}, {"processed_at", type datetime}, {"available_at", type datetime}, {"processing_group", type text}, {"received_date", type date}, {"processed_date", type date}, {"duration_min", type number}})
				in
				    Typen

