// Kapitel 14 · Abschnitt „Ein weiteres Measure aus bekannten Komponenten entwickeln“ · Codeblock 19

Daueranteil über 60 Minuten =
DIVIDE(
    COALESCE(
        CALCULATE(
            SUM('m04 fact_orders'[duration_min]),
            KEEPFILTERS('m04 fact_orders'[duration_min] > 60)
        ),
        0
    ),
    [Bearbeitungsdauer gesamt]
)
