// Kapitel 14 · Abschnitt „BLANK, Bewertungsabdeckung und vollständiger Bestandswert“ · Codeblock 13

Bekannter Bestandswert =
IF(
    HASONEVALUE('m04 dim_date'[calendar_date])
        && SELECTEDVALUE(
               'm04 fact_inventory_snapshots'[currency]
           ) = "EUR",
    SUM('m04 fact_inventory_snapshots'[inventory_value_eur]),
    BLANK()
)
